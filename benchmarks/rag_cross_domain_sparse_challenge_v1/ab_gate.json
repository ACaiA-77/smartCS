{
  "gate_version": "global-sparse-ab-gate-v1",
  "benchmark_version": "rag-cross-domain-sparse-challenge-v1",
  "benchmark_split": "challenge",
  "scoring_mode": "fact_group_v1",
  "arms": {
    "A": "domain_local_v1",
    "B": "global_corpus_v1"
  },
  "pipeline": {
    "dense_model": "BAAI/bge-m3",
    "dense_top_k": 20,
    "sparse_top_k": 20,
    "rrf_k": 60,
