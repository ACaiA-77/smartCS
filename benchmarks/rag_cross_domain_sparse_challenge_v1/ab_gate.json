    "ce_model": "BAAI/bge-reranker-v2-m3",
    "ce_top_k": 10,
    "query_rewrite": false,
    "domain_oracle": false,
    "query_domain_filter": null
  },
  "metric_contract": {
    "aggregation": "macro_mean_over_queries_in_scope",
    "wrong_domain_rate_at_10": "wrong-domain hits divided by returned hits, then query macro mean",
