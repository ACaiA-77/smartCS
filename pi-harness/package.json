{
  "name": "smartcs-pi-harness",
  "version": "0.0.0-phase0",
  "private": true,
  "description": "SmartCS Pi Harness - Phase 0 spike (version audit + SDK assertions A1-A8)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:ci": "vitest run --config vitest.ci.config.ts",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/server/main.ts",
    "outbox:status": "tsx src/cli/outbox.ts status",
    "outbox:retry": "tsx src/cli/outbox.ts retry",
    "spike": "tsx src/spike/run-spike.ts",
    "spike:sse": "tsx src/spike/run-sse-server.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.0.1",
    "@earendil-works/pi-ai": "1.0.1",
    "@earendil-works/pi-coding-agent": "1.0.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "mysql2": "3.11.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
