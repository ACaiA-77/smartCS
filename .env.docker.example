# LLM Provider
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-v4-flash

# Pi Harness (agent runtime) — see pi-harness/README.md
# Explicit, never inferred: `openai` refuses to start if the three model
# variables above are incomplete; `faux` is the deliberate offline provider.
# Leave unset only for development — an unset value refuses to serve outside a
# test process when the model configuration is incomplete.
SMARTCS_PROVIDER_MODE=openai
# off | shadow | live — `live` enables real refund/ticket writes and requires
# the durable receipt log (always present in this compose deployment).
SMARTCS_WRITE_MODE=live
# Read-tool timeout. Must cover this deployment's real RAG latency.
SMARTCS_TOOL_TIMEOUT_MS=90000
# on | off — expose registered knowledge skills to the model.
SMARTCS_SKILLS=on
# 0 | 1 — per-request RAG segment timing (dense/BM25/RRF/rerank P50/P95) in logs.
SMARTCS_RAG_TIMING=0
# Knowledge transport: http (default, no extra container) or mcp.
# For mcp, also run `docker compose --profile mcp up -d` and set the token below
# (>=16 bytes). The gateway refuses to start without it.
SMARTCS_KNOWLEDGE_TRANSPORT=http
SMARTCS_MCP_TOKEN=
# SMARTCS_MCP_URL=http://smartcs-mcp-gateway:8972/mcp

# Redis (short-term memory + context working-set cache)
REDIS_URL=redis://smartcs-redis:6379/0
# Redis unavailable: fail fast and use in-process short-term memory until retry cooldown expires.
REDIS_CONNECT_TIMEOUT_SECONDS=0.5
REDIS_RETRY_COOLDOWN_SECONDS=30

# Local SQLite domestic e-commerce demo orders
ORDER_DB_PATH=/app/data/orders.db

# Durable workflow checkpoints + user memory (independent local MySQL container).
# Start with: docker compose -f compose.checkpoint.yaml up -d
# The API container must use a host-reachable address, never 127.0.0.1 (that is the container itself).
# Docker Desktop: host.docker.internal. Plain Linux: the host LAN IP or attach the checkpoint network.
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3307
MYSQL_DATABASE=smartcs_checkpoint
MYSQL_USER=smartcs
MYSQL_PASSWORD=your-mysql-password-here
# MYSQL_ROOT_PASSWORD=your-mysql-root-password-here

# Customer authentication. Required: generate a private random secret of at least 32 bytes.
# Blank deliberately fails startup/authentication; there is no default JWT signing key.
AUTH_JWT_SECRET=
# false is for local HTTP only (the compose mapping is plain HTTP); use true behind an HTTPS proxy.
AUTH_COOKIE_SECURE=false
# Empty means same-origin only. Optional exact origins, comma-separated; wildcard is rejected.
CORS_ALLOWED_ORIGINS=
# Bootstrap once inside the container:
#   docker compose exec smartcs-api python -m scripts.init_demo_auth_user --username alice --business-user-id user_001

# Vector Store (local Python runtime)
VECTOR_STORE_TYPE=faiss
FAISS_INDEX_PATH=/app/vector_store/faiss_index

# OpenTelemetry (optional tracing)
OTEL_SERVICE_NAME=smart-cs-multi-agent
# true disables the local tracing exporter; set false or remove when an OTEL collector is intentionally configured.
OTEL_SDK_DISABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_SAMPLER=always_on

# LangSmith (optional)
# LANGSMITH_API_KEY=ls-your-langsmith-key
# LANGSMITH_PROJECT=smartcs-agent

# Server
HOST=0.0.0.0
PORT=8000

# Embedding
EMBEDDING_BACKEND=local
# Must match the model that built the jieba production indexes below.
EMBEDDING_MODEL=BAAI/bge-m3

# Round 3 dual-domain production retrieval (jieba).
# compose.yaml mounts ./artifacts/rag_jieba into the container read-only at this path.
# Prepare the directory on the host first (see README RAG section); startup fails closed when missing.
RAG_INDEX_ROOT=/app/artifacts/rag_jieba/production_indexes
RAG_SPARSE_MODE=global_corpus_v1
RAG_RERANKER_BACKEND=cross_encoder

# Keep the full RAG pipeline enabled: query rewrite -> FAISS retrieval -> rerank -> answer.
RAG_ENABLE_QUERY_REWRITE=true
RAG_ENABLE_RERANK=true

# Context engineering (central ContextManager budgets; all optional, defaults shown)
# SMARTCS_CONTEXT_LIMIT=8192            # model context window estimate for the configured model
# SMARTCS_CONTEXT_MAX_OUTPUT_TOKENS=1024
# SMARTCS_CONTEXT_RESERVE=256
# SMARTCS_CONTEXT_SAFETY_MARGIN=128     # Kimi/Moonshot native tokenization is not verified; keep a margin
# SMARTCS_CONTEXT_SOFT_RATIO=0.70       # compaction starts at soft ratio of the prompt budget
# SMARTCS_CONTEXT_HARD_RATIO=0.85       # required blocks overflowing hard budget fail closed (HTTP 409)
# SMARTCS_CONTEXT_RECENT_MESSAGES=8
# SMARTCS_CONTEXT_USER_MEMORY_TOP_K=3
# SMARTCS_CONTEXT_EVIDENCE_TOP_K=3
# SMARTCS_CONTEXT_TOOL_PREVIEW_CHARS=1200
# SMARTCS_CONTEXT_COMPRESSION_ATTEMPTS=12
