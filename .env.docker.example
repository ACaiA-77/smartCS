# LLM Provider
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-v4-flash

# Redis (short-term memory)
REDIS_URL=redis://localhost:6379/0

# Vector Store (Docker runtime)
# The host ./vector_store directory is mounted into the container at /app/vector_store.
VECTOR_STORE_TYPE=faiss
FAISS_INDEX_PATH=/app/vector_store/faiss_index

# OpenTelemetry (optional tracing)
OTEL_SERVICE_NAME=smart-cs-multi-agent
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_SAMPLER=always_on

# LangSmith (optional)
# LANGSMITH_API_KEY=ls-your-langsmith-key
# LANGSMITH_PROJECT=smart-cs-agent

# Server
HOST=0.0.0.0
PORT=8000

# API security and production readiness
# Comma-separated trusted browser origins; wildcard (*) is rejected.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=false
# Set both to true in production after Redis and the FAISS index are provisioned.
APP_REQUIRE_REDIS=false
APP_REQUIRE_RAG_INDEX=false
# Retrieval threshold; calibrate against an evaluation set before production use.
RAG_MIN_SCORE=-1.0
# Enable only for local development.
RELOAD=false

# Embedding
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# Latency controls
# When Redis is unavailable, use in-process session memory for this cooldown before retrying.
REDIS_UNAVAILABLE_RETRY_SECONDS=30
# Full-quality defaults: query rewrite, LLM rerank, and LLM compliance review remain enabled.
# Set any of these to false only for explicitly accepted low-latency experiments.
RAG_QUERY_REWRITE_ENABLED=true
RAG_LLM_RERANK_ENABLED=true
COMPLIANCE_LLM_REVIEW_ENABLED=true

# Apple support intent routing
# Low-confidence or close-priority decisions request clarification instead of guessing.
INTENT_CONFIDENCE_THRESHOLD=0.70
INTENT_CANDIDATE_MARGIN=0.15
INTENT_CONTEXT_TURNS=3
INTENT_ENTITY_TTL_TURNS=5
INTENT_FORMAT_REPAIR_ENABLED=true
INTENT_PROMPT_VERSION=apple-support-v1
