# LLM Provider
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-v4-flash

# Redis (short-term memory)
REDIS_URL=redis://localhost:6379/0
# Redis unavailable: fail fast and use in-process short-term memory until retry cooldown expires.
REDIS_CONNECT_TIMEOUT_SECONDS=0.5
REDIS_RETRY_COOLDOWN_SECONDS=30

# Local SQLite domestic e-commerce demo orders
ORDER_DB_PATH=./data/orders.db

# Durable workflow checkpoints (independent local MySQL container).
# Start with: docker compose -f compose.checkpoint.yaml up -d
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=smartcs_checkpoint
MYSQL_USER=smartcs
MYSQL_PASSWORD=replace-with-a-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-password

# Customer authentication. Required: generate a private random secret of at least 32 bytes.
# Blank deliberately fails startup/authentication; there is no default JWT signing key.
AUTH_JWT_SECRET=
# false is for local HTTP only; use true behind HTTPS.
AUTH_COOKIE_SECURE=false
# Empty means same-origin only. Optional exact origins, comma-separated; wildcard is rejected.
CORS_ALLOWED_ORIGINS=

# --- pi-harness (Phase 1) ---------------------------------------------------
# Internal service-to-service credential between pi-harness and this runtime.
# Separate from AUTH_JWT_SECRET on purpose: a leaked user token must never be
# usable as a service credential, and vice versa. Required for /internal/*;
# blank deliberately fails those endpoints instead of falling back to a default.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_SERVICE_JWT_SECRET=
# Where pi-harness listens. This runtime calls it for pi-session history
# projection and deletion. Must be reachable only on the internal network.
PI_HARNESS_BASE_URL=http://127.0.0.1:8971
# Where this runtime's /internal/* router listens, as seen from pi-harness.
PYTHON_INTERNAL_BASE_URL=http://127.0.0.1:8000
# Phase 7 cohort rollout: percentage (0-100) of NEW sessions served by
# pi-harness instead of the legacy orchestrator. The account is bucketed with a
# stable SHA-256 hash, so the same account always gets the same verdict across
# restarts, and a session keeps the harness it was created with for its whole
# life (existing sessions are never re-bucketed). 0 = legacy only (default);
# 100 = every new session goes to pi. A value outside 0-100 fails startup.
SMARTCS_PI_ROLLOUT_PERCENT=0
# Explicit Pi paths. Never rely on ~/.pi defaults in a deployed environment.
# SMARTCS_RUNTIME_CWD is the fixed working directory the agent runs in.
SMARTCS_RUNTIME_CWD=/var/lib/smartcs/runtime
# Durable volume for Pi JSONL transcripts. Losing it loses conversation history.
SMARTCS_PI_SESSION_DIR=/var/lib/smartcs/pi-sessions
# Pi agent dir (settings/models). Kept separate from the user's ~/.pi/agent.
SMARTCS_PI_AGENT_DIR=/var/lib/smartcs/pi-agent

# Max characters of a READ tool result that enter the model context. Oversized
# results are truncated with a "…<truncated>" marker; the full payload still
# travels in the tool result's details. Falls back to
# SMARTCS_CONTEXT_TOOL_PREVIEW_CHARS, then 1200.
# SMARTCS_TOOL_RESULT_MAX_CHARS=1200
# Access tokens expire after 30 minutes. Logout deletes the HttpOnly cookie, not copied tokens.
# No refresh tokens or token-revocation table; disabling an account blocks its next request.
# Bootstrap via python -m scripts.init_demo_auth_user --username alice --business-user-id user_001
# Password is prompted securely; SMARTCS_DEMO_PASSWORD is optional for one-time local setup.

# Vector Store (local Python runtime)
VECTOR_STORE_TYPE=faiss
FAISS_INDEX_PATH=./vector_store/faiss_index

# OpenTelemetry (optional tracing)
OTEL_SERVICE_NAME=smart-cs-multi-agent
# true disables the local tracing exporter; set false or remove when an OTEL collector is intentionally configured.
OTEL_SDK_DISABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_SAMPLER=always_on

# LangSmith (optional)
# LANGSMITH_API_KEY=ls-your-langsmith-key
# LANGSMITH_PROJECT=smart-cs-agent

# Context engineering (central ContextManager budgets; all optional, defaults shown)
# SMARTCS_CONTEXT_LIMIT=8192            # model context window estimate for the configured model
# SMARTCS_CONTEXT_MAX_OUTPUT_TOKENS=1024
# SMARTCS_CONTEXT_RESERVE=256
# SMARTCS_CONTEXT_SAFETY_MARGIN=128     # Kimi/Moonshot native tokenization is not verified; keep a margin
# SMARTCS_CONTEXT_SOFT_RATIO=0.70       # compaction starts at soft ratio of the prompt budget
# SMARTCS_CONTEXT_HARD_RATIO=0.85       # required blocks overflowing hard budget fail closed (HTTP 409)
# SMARTCS_CONTEXT_RECENT_MESSAGES=8
# SMARTCS_CONTEXT_USER_MEMORY_TOP_K=3
# SMARTCS_CONTEXT_EVIDENCE_TOP_K=3
# SMARTCS_CONTEXT_TOOL_PREVIEW_CHARS=1200
# SMARTCS_CONTEXT_COMPRESSION_ATTEMPTS=12

# Server
HOST=0.0.0.0
PORT=8000

# Embedding
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=BAAI/bge-m3
# Explicit local inference devices; CPU remains the default (LLM is remote).
# GPU Docker override changes only reranker to cuda:0, retaining fp32 and CPU embedding.
SMARTCS_EMBEDDING_DEVICE=cpu
SMARTCS_RERANK_DEVICE=cpu
SMARTCS_RERANK_DTYPE=fp32

# Round 3 dual-domain production retrieval
# Prepare this directory from a jieba rebuild before starting the API (see README).
RAG_INDEX_ROOT=./artifacts/rag_jieba/production_indexes
# Production default is global_corpus_v1; set domain_local_v1 to roll back.
RAG_SPARSE_MODE=global_corpus_v1
RAG_RERANKER_BACKEND=cross_encoder
# Cross-Encoder rerank clips each candidate's document text to this many
# characters before scoring (word-boundary aligned; CJK cut by character).
# `predict()` pads a batch to its longest pair, so this caps the cost of the
# whole batch. Only the rerank scoring input is clipped — dense/BM25 retrieval
# and the recall candidate set are untouched. Set 0 to disable clipping.
# 768 is measured: 512 dropped benchmark Recall@10 by 1.39pt (over the 1pt
# red line), 768 clears every quality gate and cuts rerank P95 by ~42%.
SMARTCS_RERANK_MAX_CHARS=768

# Keep the full RAG pipeline enabled: query rewrite -> FAISS retrieval -> rerank -> answer.
RAG_ENABLE_QUERY_REWRITE=true
RAG_ENABLE_RERANK=true
